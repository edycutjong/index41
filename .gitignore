# Secrets. The signing key lives in ~/.config/creditcoin/, never in the tree — but a stray .env
# is the classic way one arrives, so it is ignored before anything else. The template is not.
.env
.env.*
!.env.example
*.key
*.pem
node_modules/
__pycache__/
.next/
dist/
coverage/
.DS_Store
docs/assets/*
!docs/assets/readme-hero-animated.svg
!docs/assets/icon-animated.svg

# node / foundry / scratch
scratch/
/out/
/cache/
/broadcast/
*.log

# forge coverage — regenerated by CI's coverage gate, not checked in
/lcov.info
/coverage-summary.txt

# next.js
/.next/
/next-env.d.ts
*.tsbuildinfo

# Next 16 can regenerate these; this repo is public and they do not belong in it
/AGENTS.md
/CLAUDE.md

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# lighthouse ci
/.lighthouseci/

# the kitchen. specs/, _ideas/, _specs/ and predictions live one level up and never enter this
# repo; these lines exist so an accidental copy is refused rather than committed.
/specs/
/submission/
/graphify-out/

# vercel — deployment link metadata (project/org ids), not source
/.vercel/
.vercel
