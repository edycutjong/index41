# index41 — environment template
#
# EVERY VALUE BELOW IS OPTIONAL. There is no required environment variable in this project: the
# demo surface runs with no .env at all, against public endpoints, and `npm run dev` is the whole
# setup. This file exists to document the overrides, not to gate anything.
#
# The one credential this project uses is NOT an environment variable and must never be one: the
# relay/deployer signing key is read at runtime from ~/.config/creditcoin/index41-testnet.json
# (see src/config.ts). Do not put a private key in this file or anywhere in this repository —
# gitleaks scans the full history in CI.

# ── The demo surface (app/) ──────────────────────────────────────────────────
# Creditcoin CC3 testnet JSON-RPC. Defaults to the public node below when unset.
# Public endpoint list: https://docs.creditcoin.org/
# NEXT_PUBLIC_CC3_RPC=https://rpc.cc3-testnet.creditcoin.network

# Absolute origin of the deployed site. When unset, Open Graph image URLs stay relative rather
# than pointing at a host that may not exist — the page refuses to invent a domain.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.example

# Public GitHub URL of this repository. Empty until the repo goes public at submission; while it
# is empty every "source" link resolves to the in-app /evidence/<path> viewer instead, and the
# header's action reads "Pipeline doc" rather than "Source" (app/_components/Header.tsx).
#
# The repo now exists at the URL below but is still PRIVATE, so this stays commented out: setting
# it while the repo is private would turn every working /evidence link into a GitHub 404 — worse
# than no link at all. Set it in the SAME change that flips visibility, then redeploy:
#   gh repo edit edycutjong/index41 --visibility public --accept-visibility-change-consequences
#   vercel env add NEXT_PUBLIC_REPO_URL production   # value: https://github.com/edycutjong/index41
# NEXT_PUBLIC_REPO_URL=https://github.com/edycutjong/index41

# ── scripts/capture-proof.mjs ────────────────────────────────────────────────
# Only read by the artifact capture script. All three default to public endpoints.
# CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# Any Ethereum mainnet JSON-RPC (the script reads one block header and three transactions).
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# The Creditcoin proof-generation service. Get from: https://docs.creditcoin.org/
# PROVER_URL=https://prover.cc3-testnet.creditcoin.network
